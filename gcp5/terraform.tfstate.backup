              "\"configs\":\n  \"cm\":\n    \"admin.enabled\": \"true\"\n    \"application.instanceLabelKey\": \"argocd.argoproj.io/instance\"\n    \"exec.enabled\": \"false\"\n    \"repositories\": []\n    \"timeout.hard.reconciliation\": \"0s\"\n    \"timeout.reconciliation\": \"180s\"\n  \"secret\":\n    \"argocdServerAdminPassword\": \"$2a$12$I4Bs8bMJxEZO1FlSPFfrRe1Suru/2fkLcQms5avKJ.3QwXwbylgr6\"\n\"redis\":\n  \"enabled\": true\n  \"password\": \"\"\n\"redis-ha\":\n  \"enabled\": false\n\"server\":\n  \"insecure\": true\n  \"service\":\n    \"type\": \"LoadBalancer\"\n"
